generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  image    String
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  logo     String
  origin   String
  products Product[]
}

model Product {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  price        Int
  salePrice    Int?
  stock        Int         @default(100)
  images       String[]
  description  String
  ingredients  String
  skinType     String
  volume       String
  isBestSeller Boolean     @default(false)
  categoryId   String
  brandId      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand        Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reviews      Review[]
  orderItems   OrderItem[]
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  customerName String
  comment      String
  productId    String
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  phone         String
  address       String
  note          String?
  paymentMethod String      @default("COD")
  totalAmount   Int
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
